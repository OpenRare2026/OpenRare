# LLM (OpenAI-compatible API)
LLM_BASE_URL=https://your-api.example.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=your-model-name

# Open Targets MCP (see README for docker run)
OPEN_TARGETS_MCP_URL=http://localhost:8010/mcp

# openFDA MCP (@cyanheads/openfda-mcp-server)
# Default: public hosted HTTP server. Set OPENFDA_MCP_TRANSPORT=stdio for local npx.
OPENFDA_MCP_URL=https://openfda.caseyjhand.com/mcp
# OPENFDA_MCP_TRANSPORT=http
# OPENFDA_MCP_COMMAND=npx
# OPENFDA_MCP_ARGS=-y @cyanheads/openfda-mcp-server@latest
# OPENFDA_API_KEY=

# 1 = only Open Targets tools (default); 0 = also ClinPGx local + PubMed/arXiv
OPEN_TARGETS_ONLY=1

# Local ClinPGx/PharmGKB download (PrimaryData/ + AnnotationData/ zips)
# Relative paths are resolved from the project root.
PHARMGKB_DATA_DIR=./data/pharmGKB

# paper-search-mcp optional keys (used when OPEN_TARGETS_ONLY=0)
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=your@email.com
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
