# Copy to .env in this directory (repo root) and set paths on your machine.
# Loaded automatically by pixi, paths.sh, and path_utils.py.
# Variables already set in the shell are not overwritten.

OPENRARE_DATA_ROOT=/path/to/vep_runner
OPENRARE_PUBLIC_DATA_ROOT=/path/to/public_data
FULL_PIPELINE_REF_DIR=/path/to/phasing/CHN_ref
FULL_PIPELINE_BEAGLE_JAR=/path/to/phasing/beagle.27Feb25.75f.jar
JAVA_BIN=java
FULL_PIPELINE_API_PORT=18901

# Optional
# VEP_RUNNER_TMPDIR=/path/to/vep_tmp
# HPO_TPM_DATA_DIR=/path/to/hpo_tpm
# OPENRARE_API_TEST_VCF=/path/to/test.vcf
