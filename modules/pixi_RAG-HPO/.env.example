# Copy this file to .env and fill in your values
# cp .env.example .env

# LLM API configuration (required)
RAG_HPO_API_KEY=your-api-key-here
RAG_HPO_BASE_URL=https://api.groq.com/openai/v1/chat/completions
RAG_HPO_MODEL=llama3-groq-70b-8192-tool-use-preview

# Optional: rate limits & temperature
RAG_HPO_MAX_TOKENS_PER_DAY=500000
RAG_HPO_MAX_QUERIES_PER_MINUTE=30
RAG_HPO_TEMPERATURE=0.2
