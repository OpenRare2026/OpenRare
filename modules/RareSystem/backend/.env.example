# Rare Disease Genetic Diagnosis System - Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
# PostgreSQL connection string for variant storage and case management
DATABASE_URL=postgresql://user:password@localhost:5432/rare_disease_db

# API Configuration
# Port for the FastAPI server
API_PORT=8000

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: External Service Configuration
# gnomAD API endpoint (if using external population database)
# GNOMAD_API_URL=https://gnomad.broadinstitute.org/api

# ClinVar API endpoint (if using external clinical database)

# GFF3 annotation file for gene coordinate lookup
# GFF3_ANNOTATION_PATH=/path/to/gencode.v48.annotation.gff3
# CLINVAR_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/

# Security Configuration
# Secret key for JWT tokens (if authentication is added later)
# SECRET_KEY=your-secret-key-here

# VEP API Configuration
# Base URL for the VEP (Variant Effect Predictor) API service
VEP_API_BASE_URL=http://127.0.0.1:8000
# Maximum number of poll retries for VEP job status
VEP_POLL_MAX_RETRIES=3
# Interval between VEP job status polls (seconds)
VEP_POLL_INTERVAL_SECONDS=20
# Enable/disable VEP annotation (set to false to skip VEP and use local annotation only)
VEP_ENABLED=true
# Optional API key for VEP service authentication
# VEP_API_KEY=

# NCBI PubMed API Configuration
# Required for PubMed literature search skill
# NCBI requires an email address for identification when using E-utilities API
# Get your API key from: https://www.ncbi.nlm.nih.gov/account/settings/
# Without API key: 3 requests/second | With API key: 10 requests/second
# NCBI_EMAIL=your-email@example.com
# NCBI_API_KEY=your-api-key-here

# HPO API Configuration
# Base URL for the HPO (Human Phenotype Ontology) API service
HPO_API_BASE_URL=http://localhost:9001

# Phenotype-HPO API Configuration
# Base URL for the Phenotype-HPO extraction service
PHENOTYPE_HPO_API_BASE_URL=http://localhost:7002

# PPI Score API Configuration
# Base URL for the Protein-Protein Interaction scoring service
PPI_SCORE_API_BASE_URL=http://localhost:9000

# Report API Configuration
# Base URL for the report generation service
REPORT_API_BASE_URL=http://localhost:7000

# LLM Configuration
# Provider: openai, ollama, or compatible API
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4
LLM_BASE_URL=https://api.openai.com/v1
