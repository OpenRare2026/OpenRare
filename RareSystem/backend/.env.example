# Rare Disease Genetic Diagnosis System - Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
# Default: SQLite (auto-created, no setup required)
# For PostgreSQL: postgresql://user:password@localhost:5432/rare_disease_db
DATABASE_URL=sqlite:///./rare_disease_diagnosis.db

# API Configuration
API_PORT=18000

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8888,http://127.0.0.1:8888,http://localhost:8181,http://127.0.0.1:8181,http://localhost:18000,http://127.0.0.1:18000

# Logging Configuration
LOG_LEVEL=INFO

# LLM Configuration (required for Chat/Q&A feature)
# Provider: openai | anthropic | ollama | custom
# LLM_PROVIDER=openai
# LLM_API_KEY=your-api-key
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# External Microservice URLs (MUST update for new deployment environment)
# VEP (Variant Effect Predictor) API
VEP_API_BASE_URL=http://127.0.0.1:8000
VEP_POLL_MAX_RETRIES=180
VEP_POLL_INTERVAL_SECONDS=10
VEP_ENABLED=true
# VEP_API_KEY=

# HPO (Human Phenotype Ontology) API
HPO_API_BASE_URL=http://127.0.0.1:9001

# Phenotype-HPO mapping API
PHENOTYPE_HPO_API_BASE_URL=http://127.0.0.1:7002

# PPI Score (Protein-Protein Interaction) API
PPI_SCORE_API_BASE_URL=http://127.0.0.1:9000

# Report generation API
REPORT_API_BASE_URL=http://127.0.0.1:7000

# NCBI PubMed API Configuration (optional - for literature search)
# NCBI_EMAIL=your-email@example.com
# NCBI_API_KEY=your-api-key-here

# VEP result storage directory (default: backend/data/vep_results)
# VEP_DATA_DIR=/path/to/vep_results

# GFF3 annotation file path for gene coordinate lookup (default: backend/reference/gencode.v48.annotation.gff3)
# GFF3_ANNOTATION_PATH=/path/to/gencode.v48.annotation.gff3

# Optional: External Database URLs
# GNOMAD_API_URL=https://gnomad.broadinstitute.org/api
# CLINVAR_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/
