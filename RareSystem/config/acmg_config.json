{
  "version": "1.0.0",
  "description": "ACMG/AMP Classification Rule Engine Configuration",
  "thresholds": {
    "pathogenic": 10.0,
    "likely_pathogenic": 6.0,
    "likely_benign": -6.0,
    "benign": -10.0,
